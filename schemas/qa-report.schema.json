{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QA Report",
  "type": "object",
  "required": ["summary", "defects", "gates"],
  "properties": {
    "summary": {
      "type": "object",
      "required": ["executed", "passed", "failed", "blocked"],
      "properties": {
        "executed": {"type": "integer"},
        "passed": {"type": "integer"},
        "failed": {"type": "integer"},
        "blocked": {"type": "integer"}
      }
    },
    "defects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "status"],
        "properties": {
          "id": {"type": "string", "pattern": "^BUG-[0-9]{3}$"},
          "severity": {"type": "string", "enum": ["critical", "high", "medium", "low"]},
          "status": {"type": "string", "enum": ["open", "fixed", "verified", "waived"]}
        }
      }
    },
    "gates": {
      "type": "object",
      "properties": {
        "qa_ready": {"type": "string"}
      }
    }
  }
}
